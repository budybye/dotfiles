{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(jj status *)",
      "Bash(jj diff *)",
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj file list *)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi verify *)",
      "Bash(chezmoi managed *)",
      "Bash(chezmoi ignored *)",
      "Bash(mise ls *)",
      "Bash(mise which *)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make verify)",
      "Bash(shellcheck *)",
      "Bash(bash -n *)",
      "Bash(zsh -n *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(which *)",
      "Bash(command -v *)"
    ],
    "ask": [
      "Bash(chezmoi execute-template *)",
      "Bash(git push *)",
      "Bash(jj git push *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.age)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/mise/age.txt)",
      "Read(./build)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard *)",
      "Bash(chezmoi purge *)",
      "Bash(chezmoi destroy *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"[\\(.model.display_name)] \\(.context_window.used_percentage // 0)% context\"'"
  }
}
