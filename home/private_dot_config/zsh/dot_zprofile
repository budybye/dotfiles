# .zprofile はログインシェルで読み込まれる
# .profile からbashと共通の環境変数を読み込む

if [ -f "${HOME}/.profile" ]; then
  emulate sh -c "source ${HOME}/.profile"
fi

# PATHを再設定
# -U は重複を排除する
typeset -U path PATH
# (N-/) は その directory が存在する場合のみ追加する
path=(
  /opt/homebrew/bin(N-/)
  /opt/homebrew/sbin(N-/)
  /usr/bin
  /usr/sbin
  /bin
  /sbin
  /usr/local/bin(N-/)
  /usr/local/sbin(N-/)
  /Library/Apple/usr/bin(N-/)
  /Applications/Obsidian.app/Contents/MacOS(N-/)
  /opt/X11/bin(N-/)
  /snap/bin(N-/)
  ${HOME}/.local/share/mise/shims(N-/)
  ${HOME}/.console-ninja/.bin(N-/)
  ${HOME}/.local/share/bun/bin(N-/)
  ${HOME}/.cache/.bun/bin(N-/)
  ${HOME}/.bun/bin(N-/)
  ${HOME}/.local/share/go/bin(N-/)
  ${HOME}/go/bin(N-/)
  # rustc/cargo/rustup は mise (rust@stable)。ここは cargo install / binstall 用
  ${HOME}/.local/share/cargo/bin(N-/)
  ${HOME}/.local/share/sheldon/repos/github.com/*/*/bin(N-/)
  ${HOME}/.local/share/gem/bin(N-/)
  ${HOME}/.local/bin(N-/)
  ${path}
)

# プロンプトの設定
# ユーザー名@ホスト名:現在のディレクトリ $ の形式
PROMPT='%F{green}%n@%m%f:%F{blue}%~ %f%F{yellow}$%f '

# 対話シェルは zsh が .zprofile の後に自分で .zshrc を読むので、ここでは読まない（二重実行の回避）
# 非対話の login シェル（zsh -lc cmd。AI エージェント等）は本物のコマンドを見せる必要があるので
# .zshrc / .functions（alias・chpwd・zoxide・プロンプト等の対話用設定）は読まない
# mise は shims で足りる。`mise activate` は config.toml の enter hook が stdout にバナーを出すので
# 非対話では呼ばない（対話シェルは .zshrc で activate する）。システムの /usr/bin/jq 等より
# mise の shims を優先させるため、非対話では shims を PATH 先頭に置く
# mux の自動起動は .zlogin（.zshrc の後）
if [[ ! -o interactive ]]; then
  path=(${HOME}/.local/share/mise/shims(N-/) ${path})
  # Vite+ の bin を PATH 先頭に置く。env を source すると PATH の組み替えが遅い（0.6〜1.6 秒）ので、
  # `vp env use` 用の関数が要らない非対話では bin だけ足す
  path=(${HOME}/.config/vite-plus/bin(N-/) ${path:#${HOME}/.config/vite-plus/bin})
fi
