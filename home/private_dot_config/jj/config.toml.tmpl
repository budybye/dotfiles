[user]
name = {{ .name | quote }}
email = {{ .email | quote }}

# git の includeIf (git/dayjobdoor.conf, git/boborder.conf) と同じ identity
[[--scope]]
--when.repositories = ["~/Developer/dayjobdoor"]
