name = "dayjobdoor"
email = "145406603+dayjobdoor@users.noreply.github.com"

[[--scope]]
--when.repositories = ["~/Developer/boborder"]
[--scope.user]
name = "boborder"
email = "88989797+boborder@users.noreply.github.com"
