{
  "mcpServers": {
    "brave-devtools": {
      "command":"npx",
      "args":["-y", "brave-mcp@latest"],
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "ccxt": { 
      "command": "npx", 
      "args": ["-y", "ccxt-mcp"],
      "lifecycle": "lazy",
      "idleTimeout": 10 
    },
    "mise": {
      "command": "mise",
      "args": ["mcp"],
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "mcp-mermaid": {
      "command": "npx",
      "args": ["-y", "mcp-mermaid"],
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "cloudflare-docs": {
      "type": "url",
      "url": "https://docs.cloudflare.com/mcp"
    },
    "context7": {
      "type": "url",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
