// タブ1: 4ペイン home vertical
// タブ2: 4ペイン mpd horizontal
// タブ3: 4ペイン Developer
// タブ4: 1ペイン herdr
// タブ5: 1ペイン omp
// タブ6: 2ペイン spynel
// タブ7: 2ペイン 縦列 lazyxrp/rippled
// タブ8: 1ペイン lazydocker

layout {
    // デフォルトタブテンプレート
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }

        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="101" {
        pane split_direction="vertical" {
            pane {
                name "dotfiles"
                cwd "~/dotfiles"
                command "fastfetch"
                focus true
            }
            pane {
                name "home"
                cwd "~"
                command "btm"
            }
        }
    }

    tab name="102" {
        pane split_direction="horizontal" {
            pane {
                name "ncmpcpp"
                cwd "~/Music"
                command "ncmpcpp"
                focus true
            }
            pane {
                name "Data"
                cwd "~/data"
                command "cat"
                args "./cat.txt"
            }
        }
    }

    tab name="Dev" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane {
                    name "dev1"
                    cwd "~/Developer"
                }
                pane {
                    name "dev2"
                    cwd "~/Developer"
                }
            }
            pane split_direction="horizontal" {
                pane {
                    name "dev3"
                    cwd "~/Developer"
                }
                pane {
                    name "dev4"
                    cwd "~/Developer"
                    focus true
                }
            }
        }
    }

    tab name="herdr" {
        pane {
            name "herdr"
            cwd "~/Developer"
            command "herdr"
        }
    }
    
    tab name="Docs" {
        pane {
            name "spynel"
            cwd "~/Developer/docs"
            command "spynel"
        }
    }
    
    // tab name="xrp" {
    //     pane split_direction="vertical" {
    //         name "lazyxrp"
    //         cwd "~/Developer/rust/lazyxrp"
    //         command "cargo"
    //         args "clippy"
    //     }
    //     pane {
    //         name "rippled"
    //         cwd "~/Developer/rippled"
    //         command "make"
    //         args "help"
    //     }
    // }
    
    // tab name="docker" {
    //     pane {
    //         name "lazydocker"
    //         cwd "~/Developer"
    //         command "lazydocker"
    //     }
    // }
}
