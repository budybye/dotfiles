// タブ1: 4ペイン home
// タブ2: 4ペイン Developer
// タブ3: 1ペイン herdr
// タブ4: 2ペイン 並列 pi/omp
// タブ5: 2ペイン 縦列 lazyxrp/rippled
// タブ6: 1ペイン lazydocker

layout {
    // デフォルトタブテンプレート
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }

        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="101" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane {
                    name "home"
                    cwd "~"
                    command "btm"
                }
                pane {
                    name "dotfiles"
                    cwd "~/dotfiles"
                    command "fastfetch"
                    focus true
                }
            }
            pane split_direction="horizontal" {
                pane {
                    name "ncmpcpp"
                    cwd "~/Music"
                    command "ncmpcpp"
                }
                pane {
                    name "Data"
                    cwd "~/data"
                    command "cat"
                    args "./cat.txt"
                }
            }
        }
    }

    tab name="Dev" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane {
                    name "dev1"
                    cwd "~/Developer"
                }
                pane {
                    name "dev2"
                    cwd "~/Developer"
                }
            }
            pane split_direction="horizontal" {
                pane {
                    name "dev3"
                    cwd "~/Developer"
                }
                pane {
                    name "dev4"
                    cwd "~/Developer"
                    focus true
                }
            }
        }
    }

    tab name="herdr" {
        pane {
            name "herdr"
            cwd "~/Developer"
            command "herdr"
        }
    }
    
    tab name="edit" {
        pane split_direction="vertical" {
            pane {
                name "omp"
                cwd "~/Developer"
                command "omp"
                args "-c"
            }
            pane {
                name "pi"
                cwd "~/Developer/docs"
                command "pi"
                args "-c"
            }
        }
    }

    // tab name="xrp" {
    //     pane {
    //         name "lazyxrp"
    //         cwd "~/Developer/rust/lazyxrp"
    //         command "cargo"
    //         args "clippy"
    //     }
    //     pane {
    //         name "rippled"
    //         cwd "~/Developer/rippled"
    //         command "make"
    //         args "help"
    //     }
    // }
    
    tab name="docker" {
        pane {
            name "lazydocker"
            cwd "~/Developer"
            command "lazydocker"
        }
    }
}
