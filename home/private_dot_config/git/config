[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

# user.confからユーザー情報を読み込む
[include]
	path = ~/.config/git/user.conf

[alias]
	t = tag
	s = status
	st = status
	a = add
	ad = add
	b = branch
	br = branch
	cm = commit -m
	cv = commit -v
	co = checkout
	dc = diff --cached
	pl = pull
	ps = push
	pom = push origin main
	psf = push --force-with-lease
	fml = reset --hard HEAD
	conf = config --global
	hist = log --pretty=format:\"%C(cyan)%h %C(green)%ad%Creset | %s %C(yellow)%d %C(magenta)[%an]\" --graph --date=short
	unstage = rm --cached -r

[blame]
	coloring = highlightRecent

[color]
	ui = auto

[color "blame"]
	highlightRecent = dim white,30 month ago,dim magenta,24 month ago,dim blue,18 month ago,dim cyan,15 month ago,dim green,12 month ago,dim yellow,9 month ago,dim red,6 month ago,bold magenta,3 month ago,bold blue,2 month ago,bold cyan,6 week ago,bold green,4 week ago,bold yellow,2 week ago,bold red

[color "decorate"]
	HEAD = cyan
	remoteBranch = red bold
	stash = yellow
	tag = blue bold

[color "diff"]
	frag = white blue
	meta = black yellow

[color "grep"]
	filename = magenta
	lineNumber = green

[core]
	excludesfile = ~/.config/git/ignore
	repositoryformatversion = 0
	filemode = true
	bare = true
	ignorecase = true
	# 日本語を正常に表示させる
	quotepath = false
	# delta は mise 管理（tools.toml）。未導入の環境では pager が起動せず素の出力になる
	pager = delta

[commit]
	verbose = true
	template = ~/.config/git/commit.template

[diff]
	algorithm = histogram
	indentHeuristic = true
	renameLimit = 10000
	renames = copies
	statGraphWidth = 8

[help]
	autocorrect = 30

[push]
	default = simple
	gpgSign = if-asked
	followTags = true
	autoSetupRemote = true

[rebase]
	missingCommitsCheck = warn

[rerere]
	enabled = true

[tag]
	forceSignAnnotated = true

[delta]
	line-numbers = true
	side-by-side = false

[init]
	defaultBranch = main

[pull]
	rebase = true
	twohead = ort

[branch]
	autosetuprebase = always

[coderabbit]
	machineId = cli/1a4d0ca15ac647399db6b5c0fadd3875

# ~/Developer/dayjobdoor 配下は dayjobdoor に固定(user.conf より後なので優先される)
[includeIf "gitdir:~/Developer/dayjobdoor/"]
    path = ~/.config/git/dayjobdoor.conf

# ~/Developer/boborder 配下は boborder の noreply に固定
[includeIf "gitdir:~/Developer/boborder/"]
    path = ~/.config/git/boborder.conf
[credential "https://github.com"]
	helper = 
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !$HOME/.local/share/mise/shims/gh auth git-credential
