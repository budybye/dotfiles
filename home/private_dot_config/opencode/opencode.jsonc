{
  "providers": {
    "sakura": {
      "name": "Sakura AI Engine",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.ai.sakura.ad.jp/v1",
      },
      "models": {
        "preview/kimi-k2.7-code": {
          "name": "Kimi",
        },
      },
    },
  },
  "update": "auto",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"],
  },
  "plugins": [],
  "mcp": {
    "servers": {
      "cloudflare-docs": {
        "type": "remote",
        "url": "https://docs.mcp.cloudflare.com/mcp",
      },
    },
  },
}
