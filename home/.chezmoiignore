# apply で配置されないファイルの指定
# ファイルが配置されるときの名前にする run_ once_ after_ .tmpl はつけない
# .name などのdata は .chezmoi.toml.tmpl

key.txt*
.config/omp/**/config.yml.lock

{{ if not .github }}
.config/gh/**
.config/git/user.conf
.config/jj/config.toml
{{ end }}

{{ if not .age }}
.ssh/id_rsa*
.ssh/id_ed25519*
.env*
# omp の models.yml は apiKey に環境変数 CLOUDFLARE_API_KEY を参照する。.env と同じ条件で配置する
.config/**/agent/models.yml
{{ end }}

{{ if not .ssh }}
.ssh/**
{{ end }}

{{ if ne (env "GITHUB_ACTIONS") "true" }}
.chezmoiscripts/watch.sh
{{ end }}

{{ if eq (env "DOCKER") "true" }}
.chezmoiscripts/linux/setup.sh
{{ end }}

{{ if eq (env "REMOTE_CONTAINERS") "true" }}
.chezmoiscripts/vscode.sh
.chezmoiscripts/linux/gui.sh
.chezmoiscripts/linux/docker.sh
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
.config/Brewfile
.config/karabiner
.config/sol
.config/cmux
.ssh/id_rsa*
.chezmoiscripts/darwin/**
.local/bin/applist
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.config/fcitx5
.config/fusuma
.chezmoiscripts/linux/**
{{ end }}

{{ if eq .chezmoi.os "windows" }}
.config/**
.ssh/**
.zshenv
.local/**
*rc
*profile
.aliases
.env*
.chezmoiscripts/**/*.sh
{{ else }}
.config/scoop
.chezmoiscripts/windows/**
{{ end }}
