# apply で配置されないファイルの指定
# ファイルが配置されるときの名前にする run_ once_ after_ .tmpl はつけない
# .name などのdata は .chezmoi.toml.tmpl

.DS_Store
**/.DS_Store
.chezmoiexternal.*
key.txt*

{{ if eq (env "GITHUB_ACTIONS") "true" }}
.ssh/authorized_keys
.ssh/id_ed25519*
.ssh/id_rsa*
{{ end }}

{{ if eq (env "DOCKER") "true" }}
.ssh/id_ed25519*
.ssh/id_rsa*
.env*
.chezmoiscripts/vscode.sh
.chezmoiscripts/age.sh
.chezmoiscripts/linux/docker.sh
.chezmoiscripts/linux/setup.sh

{{ else if eq (env "REMOTE_CONTAINERS") "true" }}
.ssh/id_ed25519*
.ssh/id_rsa*
.env*
.chezmoiscripts/vscode.sh
.chezmoiscripts/age.sh
.chezmoiscripts/linux/docker.sh
.chezmoiscripts/linux/gui.sh
.chezmoiscripts/linux/setup.sh
{{ end }}

{{ if eq .github false }}
.config/git/user*
{{ end }}

{{ if eq .age false }}
.ssh/id_rsa*
.ssh/id_ed25519*
.env*
.chezmoiscripts/age.sh
{{ end }}

{{ if eq .ssh false }}
.ssh/**
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
.config/Brewfile
.config/karabiner
.ssh/id_rsa*
.chezmoiscripts/darwin/**
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.config/fcitx5
.config/fusuma
.local/share/fonts
.local/share/icons
.local/share/themes
.chezmoiscripts/linux/**
{{ end }}

{{ if eq .chezmoi.os "windows" }}
.config/**
.ssh/**
*rc
*profile
.aliases
.env*
.chezmoiscripts/*.sh
{{ else }}
.config/scoop
.chezmoiscripts/windows/**
{{ end }}
