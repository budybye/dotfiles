# ZDOTDIR を設定
if [ -d "${HOME}/.config/zsh" ]; then
    export ZDOTDIR="${ZDOTDIR:-${HOME}/.config/zsh}"
else
    export ZDOTDIR="${HOME}"
fi

# ${HOME}/.zshenv は全ての zsh で読まれるので ${ZDOTDIR} を指定する
# 読み込み順（login + interactive の場合）:
# ${ZDOTDIR}/.zprofile -> .profile から環境変数と PATH を設定（非対話 login ならここで .zshrc も読む）
# ${ZDOTDIR}/.zshrc -> 対話シェルの設定。最後に .functions（alias・関数）を読み込む。.aliases は bash 用で zsh は読まない
# ${ZDOTDIR}/.zlogin -> ログインシェルで読み込まれる。herdr などの mux をここで自動起動
# ${ZDOTDIR}/.zlogout -> ログアウト時に読み込まれる

# PATHを設定
typeset -U PATH path
path=(
    ${path}
    ${HOME}/.local/bin(N-/)
    /opt/homebrew/bin(N-/)
    /opt/homebrew/sbin(N-/)
    /usr/bin
    /usr/sbin
    /bin
    /sbin
    /usr/local/bin(N-/)
    /usr/local/sbin(N-/)
    /Library/Apple/usr/bin(N-/)
)