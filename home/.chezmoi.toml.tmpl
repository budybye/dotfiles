{{/* シークレット系 */}}
{{- $age := false -}}{{/* age 暗号化。hotmilk/budybye の対話環境だけ true（CI・コンテナ・SANDBOX では暗号化 file を処理しない） */}}

{{/* github系 */}}
{{- $github := false -}}{{/* gh / git user.conf / jj config の配備を許可する（.chezmoiignore） */}}
{{- $ssh := false -}}{{/* ~/.ssh 全体（config・鍵・authorized_keys）の配備を許可する（.chezmoiignore） */}}

{{/* github ユーザー名の設定 */}}
{{- $name := "budybye" -}}
{{- $email := "101wayout@gmail.com" -}}

{{/* OSの検出 linuxの場合は distribution を取得する */}}
{{- $osID := .chezmoi.os -}}
{{- if (and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id")) -}}
{{- $osID = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}

{{/* 環境毎に name email github ssh を設定する */}}

{{/* Actions */}}
{{- if eq (env "GITHUB_ACTIONS") "true" -}}
    {{- $name = "runner" -}}
    {{- $github = true -}}
    {{- $ssh = false -}}

{{/* Codespaces */}}
{{- else if eq (env "CODESPACES") "true" -}}
    {{- $name = "vscode" -}}
    {{- $github = true -}}
    {{- $ssh = false -}}

{{/* Remote Containers */}}
{{- else if eq (env "REMOTE_CONTAINERS") "true" -}}
    {{- $name = "dev" -}}
    {{- $github = true -}}
    {{- $ssh = false -}}

{{/* Docker */}}
{{- else if eq (env "DOCKER") "true" -}}
    {{- $name = "docker" -}}
    {{- $github = true -}}
    {{- $ssh = false -}}

{{/* SANDBOX（使い捨て VM 等。非空で有効） */}}
{{- else if ne (env "SANDBOX") "" -}}
    {{- $name = "sandbox" -}}
    {{- $email = "null" -}}
    {{- $github = true -}}
    {{- $ssh = false -}}

{{/* username が budybye（OS 問わず。Ubuntu lxd など） */}}
{{- else if eq .chezmoi.username "budybye" -}}
    {{- $age = true -}}
    {{- $github = true -}}
    {{- $ssh = true -}}

{{/* Ubuntu multipass */}}
{{- else if eq .chezmoi.os "linux" -}}
    {{- $github = true -}}
    {{- $ssh = true -}}

{{/* Mac */}}
{{- else if eq .chezmoi.username "hotmilk" -}}
    {{- $age = true -}}
    {{- $github = true -}}
    {{- $ssh = true -}}

{{- else if eq .chezmoi.os "darwin" -}}
    {{- $github = true -}}
    {{- $ssh = true -}}
    
{{/* その他、windows */}}
{{- else -}}
    {{- $name = .chezmoi.username -}}
    {{- $email = "null" -}}
    {{- $age = false -}}
    {{- $github = false -}}
    {{- $ssh = false -}}
{{- end -}}

# シンボリックリンクを作成する
mode = "symlink"

sourceDir = {{ .chezmoi.sourceDir | quote }}

# ファイルのパーミッションを変更する
# umask = 0o22

scriptTempDir = "{{ .chezmoi.homeDir }}/tmp"

{{/* age 暗号化: Chezmoi encrypted files は passphrase/symmetric */}}
{{- if $age }}
encryption = "age"
[age]
    passphrase = true
    symmetric = true
{{- end }}

{{/* ".data.***" or ".***" の設定 */}}
[data]
    email = {{ $email | quote }}
    name = {{ $name | quote }}
    osid = {{ $osID | quote }}
    age = {{ $age }}
    github = {{ $github }}
    ssh = {{ $ssh }}

{{/* github の設定 */}}
[github]
    refreshPeriod = "12h"

{{/* Windows スクリプトのインタープリタ設定 */}}
[interpreters.ps1]
    command = "powershell.exe"
    args = ["-NoProfile", "-NonInteractive", "-File"]

{{/* ファイルの編集 */}}
[edit]
    command = "vim"
    # command = "code"
    # commandArgs = ["--wait"]
