#!/usr/bin/env bash

set -euo pipefail

if ! command -v curl >/dev/null 2>&1; then
    printf '%s\n' "curl not found" >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    printf '%s\n' "jq not found" >&2
    exit 1
fi

usage() {
    cat <<'EOF'
Usage: xrp [-v|--verbose] [-h|--help] [ACCOUNT [ISSUER [CURRENCY [CURRENCY_CODE]]]]

Arguments:
  ACCOUNT        照会する XRPL アドレス
  ISSUER         通貨の発行者アドレス
  CURRENCY       通貨名(既定 RLUSD)
  CURRENCY_CODE  通貨コード。省略時は CURRENCY から作る
                 (3 文字はそのまま、4 文字以上は ASCII の 16 進を 40 桁に 0 埋め)

Environment:
  XRP_ACCOUNT, XRP_ISSUER, XRP_CURRENCY, XRP_CURRENCY_CODE  引数の既定値
  XRPL_SERVER           JSON-RPC の URL(既定 https://xrpl.ws)
  XRPL_CONNECT_TIMEOUT  接続タイムアウト秒(既定 5)
  XRPL_TIMEOUT          全体タイムアウト秒(既定 15)

Options:
  -v, --verbose  取得した JSON をそのまま表示する
EOF
}

# verbose option parsing (-v anywhere)
VERBOSE=0
POSITIONAL=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf 'Unknown option: %s\n\n' "$1" >&2
            usage >&2
            exit 2
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done
if [ "$#" -gt 0 ]; then
    POSITIONAL+=("$@")
fi
# ${arr[@]+...}: empty-array safe under set -u on bash < 4.4 (macOS /bin/bash 3.2).
set -- ${POSITIONAL[@]+"${POSITIONAL[@]}"}

if [ "$#" -gt 4 ]; then
    printf '%s\n\n' "Too many arguments" >&2
    usage >&2
    exit 2
fi

# XRP Ledger public server
readonly XRPL_SERVER="${XRPL_SERVER:-https://xrpl.ws}"
readonly XRPL_CONNECT_TIMEOUT="${XRPL_CONNECT_TIMEOUT:-5}"
readonly XRPL_TIMEOUT="${XRPL_TIMEOUT:-15}"

# $1: account
# $2: issuer
# $3: currency
# $4: currency_code
# 環境変数は XRP_ 接頭辞付きだけを読む。ACCOUNT や CURRENCY は他のツールや .env と衝突する。

# default account ripple
ACCOUNT="${1:-${XRP_ACCOUNT:-r3kmLJN5D28dHuH8vZNUZpMC43pEHpaocV}}"
# default Ripple RLUSD
ISSUER="${2:-${XRP_ISSUER:-rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De}}"
CURRENCY="${3:-${XRP_CURRENCY:-RLUSD}}"

if ! [[ "${CURRENCY}" =~ ^[[:alnum:]]{1,20}$ ]] || [ "${CURRENCY}" = "XRP" ]; then
    printf 'Invalid currency: %s\n' "${CURRENCY}" >&2
    exit 1
fi

# 3 文字は標準コードそのまま。それ以外は ASCII の 16 進を 40 桁に 0 で埋めた非標準コード。
currency_to_code() {
    local hex
    if [ "${#1}" -eq 3 ]; then
        printf '%s' "$1"
        return
    fi
    hex="$(printf '%s' "$1" | od -An -tx1 | tr -d ' \n' | tr 'a-f' 'A-F')"
    printf '%-40s' "${hex}" | tr ' ' '0'
}
CURRENCY_CODE="${4:-${XRP_CURRENCY_CODE:-$(currency_to_code "${CURRENCY}")}}"

# XRPL base58 dictionary excludes 0, O, I, l; account addresses start with r (<= 35 chars).
# Checksum is verified server-side (malformed -> actMalformed via parse_rpc_result).
for addr in "${ACCOUNT}" "${ISSUER}"; do
    if ! [[ "${addr}" =~ ^r[1-9A-HJ-NP-Za-km-z]{24,34}$ ]]; then
        printf 'Invalid XRPL address: %s\n' "${addr}" >&2
        exit 1
    fi
done
# Currency code: 3-char standard code or 40-hex non-standard code.
if ! [[ "${CURRENCY_CODE}" =~ ^([[:alnum:]]{3}|[0-9A-Fa-f]{40})$ ]]; then
    printf 'Invalid currency code: %s\n' "${CURRENCY_CODE}" >&2
    exit 1
fi

# JSON-RPC request
json_rpc_request() {
    curl --fail --silent --show-error \
        --connect-timeout "${XRPL_CONNECT_TIMEOUT}" \
        --max-time "${XRPL_TIMEOUT}" \
        -H 'Content-Type: application/json' \
        --data-binary "$1" \
        "${XRPL_SERVER}"
}

# Extract result and reject HTTP/Ripple API errors.
parse_rpc_result() {
    jq -e '
        if (.error? != null) then
            error((.error_message // .error // "XRPL API error") | tostring)
        elif (.result? == null) then
            error("XRPL response has no result")
        elif (.result.status? == "error" or .result.error? != null) then
            error(
                (.result.error_message // .result.error // "XRPL API error")
                | tostring
            )
        else
            .result
        end
    '
}

GET_SERVER_INFO='{"method":"server_info","params":[{}]}'
GET_FEE='{"method":"fee","params":[{}]}'
GET_ACCOUNT_INFO="$(
    jq -nc --arg account "${ACCOUNT}" \
        '{method:"account_info",params:[{account:$account,ledger_index:"validated"}]}'
)"
GET_OFFERS="$(
    jq -nc \
        --arg currency "${CURRENCY_CODE}" \
        --arg issuer "${ISSUER}" \
        '{
            method:"book_offers",
            params:[{
                taker_gets:{currency:"XRP"},
                taker_pays:{currency:$currency,issuer:$issuer},
                limit:1,
                ledger_index:"validated"
            }]
        }'
)"

if [ "${VERBOSE}" -eq 1 ]; then
    SERVER_INFO_RESPONSE="$(json_rpc_request "${GET_SERVER_INFO}")"
fi
FEE_RESPONSE="$(json_rpc_request "${GET_FEE}")"
ACCOUNT_INFO_RESPONSE="$(json_rpc_request "${GET_ACCOUNT_INFO}")"
OFFER_RESPONSE="$(json_rpc_request "${GET_OFFERS}")"

if [ "${VERBOSE}" -eq 1 ]; then
    printf '%s\n' "${SERVER_INFO_RESPONSE}" | jq .
    printf '%s\n' "${FEE_RESPONSE}" | jq .
    printf '%s\n' "${ACCOUNT_INFO_RESPONSE}" | jq .
    printf '%s\n' "${OFFER_RESPONSE}" | jq .
fi

FEE_RESULT="$(printf '%s\n' "${FEE_RESPONSE}" | parse_rpc_result)"
ACCOUNT_INFO_RESULT="$(printf '%s\n' "${ACCOUNT_INFO_RESPONSE}" | parse_rpc_result)"
OFFER_RESULT="$(printf '%s\n' "${OFFER_RESPONSE}" | parse_rpc_result)"

LEDGER_INDEX="$(printf '%s\n' "${FEE_RESULT}" | jq -er '.ledger_current_index')"
OPEN_LEDGER_FEE="$(printf '%s\n' "${FEE_RESULT}" | jq -er '.drops.open_ledger_fee')"
ACCOUNT_BALANCE="$(printf '%s\n' "${ACCOUNT_INFO_RESULT}" | jq -er \
    '.account_data.Balance | tonumber / 1000000')"
XRP_CURRENCY_QUALITY="$(
    printf '%s\n' "${OFFER_RESULT}" |
        jq -er '
            if ((.offers // []) | length) == 0 then
                error("no offers found")
            else
                (.offers[0].quality | tonumber * 1000000)
            end
        '
)"

# Best-offer estimate. quality is expressed in serialized units:
# IOU per XRP drop, so multiply by 1,000,000 to get currency per XRP.
ACCOUNT_CALC_PRICE="$(
    awk -v balance="${ACCOUNT_BALANCE}" \
        -v quality="${XRP_CURRENCY_QUALITY}" \
        'BEGIN {printf "%.3f", balance * quality}'
)"

cat <<'EOF'
__  ______  ____    _             _
\ \/ /  _ \|  _ \  | |    ___  __| | __ _  ___ _ ___
 \  /| |_) | |_) | | |   / _ \/ _` |/ _` |/ _ \ '__|
 /  \|  _ <|  __/  | |__|  __/ (_| | (_| |  __/ |
/_/\_\_| \_\_|     |_____\___|\__,_|\__, |\___|_|
                                    |___/
EOF
printf 'UTC: %s\n' "$(LC_ALL=C date -u +%Y%m%dT%H%M%SZ)"
# URL に API key が入ることがあるので host までしか出さない。
printf 'Rippled Server: %s\n' "$(
    printf '%s' "${XRPL_SERVER}" |
        sed -E -e 's#(://)[^/@]*@#\1#' -e 's#^([A-Za-z]+://[^/?]+).*#\1#'
)"
printf 'LedgerIndex (open): %s\n' "${LEDGER_INDEX}"
printf 'OpenLedgerFee: %s (drops)\n' "${OPEN_LEDGER_FEE}"
printf '%s\n' '------------------------------------------------------'
printf 'Issuer: %s\n' "${ISSUER}"
printf 'Currency: %s\n' "${CURRENCY}"
printf 'CurrencyCode: %s\n' "${CURRENCY_CODE}"
printf 'Best offer price: 1 XRP = %s %s\n' \
    "$(awk -v q="${XRP_CURRENCY_QUALITY}" 'BEGIN {printf "%.6f", q}')" "${CURRENCY}"
printf '%s\n' '------------------------------------------------------'
printf 'Account: %s\n' "${ACCOUNT}"
printf 'Balance: %s XRP\n' "${ACCOUNT_BALANCE}"
printf 'Estimated value at best offer: %s %s\n' \
    "${ACCOUNT_CALC_PRICE}" "${CURRENCY}"
printf '%s\n' '------------------------------------------------------'
