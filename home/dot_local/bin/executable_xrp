#!/usr/bin/env bash

set -euo pipefail

if ! command -v curl >/dev/null 2>&1; then
    printf '%s\n' "curl not found" >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    printf '%s\n' "jq not found" >&2
    exit 1
fi

# verbose option parsing (-v anywhere)
VERBOSE=0
POSITIONAL=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            printf 'Unknown option: %s\n' "$1" >&2
            exit 1
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done
if [ "$#" -gt 0 ]; then
    POSITIONAL+=("$@")
fi
set -- "${POSITIONAL[@]}"

# XRP Ledger public server
readonly XRPL_SERVER="${XRPL_SERVER:-https://xrpl.ws}"
readonly XRPL_CONNECT_TIMEOUT="${XRPL_CONNECT_TIMEOUT:-5}"
readonly XRPL_TIMEOUT="${XRPL_TIMEOUT:-15}"

# $1: account
# $2: issuer
# $3: currency
# $4: currency_code
# $5: limit

# default account ripple
ACCOUNT="${1:-${ACCOUNT:-r3kmLJN5D28dHuH8vZNUZpMC43pEHpaocV}}"
# default Ripple RLUSD
ISSUER="${2:-${ISSUER:-rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De}}"
CURRENCY="${3:-${CURRENCY:-RLUSD}}"
CURRENCY_CODE="${4:-${CURRENCY_CODE:-524C555344000000000000000000000000000000}}"
OFFER_LIMIT="${5:-${OFFER_LIMIT:-1}}"

case "${OFFER_LIMIT}" in
    ''|0|*[!0-9]*)
        printf '%s\n' "OFFER_LIMIT must be a positive integer" >&2
        exit 1
        ;;
esac

# JSON-RPC request
json_rpc_request() {
    curl --fail --silent --show-error \
        --connect-timeout "${XRPL_CONNECT_TIMEOUT}" \
        --max-time "${XRPL_TIMEOUT}" \
        -H 'Content-Type: application/json' \
        --data-binary "$1" \
        "${XRPL_SERVER}"
}

# Extract result and reject HTTP/Ripple API errors.
parse_rpc_result() {
    jq -e '
        if (.error? != null) then
            error((.error_message // .error // "XRPL API error") | tostring)
        elif (.result? == null) then
            error("XRPL response has no result")
        elif (.result.status? == "error" or .result.error? != null) then
            error(
                (.result.error_message // .result.error // "XRPL API error")
                | tostring
            )
        else
            .result
        end
    '
}

GET_SERVER_INFO='{"method":"server_info","params":[{}]}'
GET_FEE='{"method":"fee","params":[{}]}'
GET_ACCOUNT_INFO="$(
    jq -nc --arg account "${ACCOUNT}" \
        '{method:"account_info",params:[{account:$account}]}'
)"
GET_OFFERS="$(
    jq -nc \
        --arg currency "${CURRENCY_CODE}" \
        --arg issuer "${ISSUER}" \
        --argjson limit "${OFFER_LIMIT}" \
        '{
            method:"book_offers",
            params:[{
                taker_gets:{currency:"XRP"},
                taker_pays:{currency:$currency,issuer:$issuer},
                limit:$limit
            }]
        }'
)"

if [ "${VERBOSE}" -eq 1 ]; then
    SERVER_INFO_RESPONSE="$(json_rpc_request "${GET_SERVER_INFO}")"
fi
FEE_RESPONSE="$(json_rpc_request "${GET_FEE}")"
ACCOUNT_INFO_RESPONSE="$(json_rpc_request "${GET_ACCOUNT_INFO}")"
OFFER_RESPONSE="$(json_rpc_request "${GET_OFFERS}")"

if [ "${VERBOSE}" -eq 1 ]; then
    printf '%s\n' "${SERVER_INFO_RESPONSE}" | jq .
    printf '%s\n' "${FEE_RESPONSE}" | jq .
    printf '%s\n' "${ACCOUNT_INFO_RESPONSE}" | jq .
    printf '%s\n' "${OFFER_RESPONSE}" | jq .
fi

FEE_RESULT="$(printf '%s\n' "${FEE_RESPONSE}" | parse_rpc_result)"
ACCOUNT_INFO_RESULT="$(printf '%s\n' "${ACCOUNT_INFO_RESPONSE}" | parse_rpc_result)"
OFFER_RESULT="$(printf '%s\n' "${OFFER_RESPONSE}" | parse_rpc_result)"

LEDGER_INDEX="$(printf '%s\n' "${FEE_RESULT}" | jq -er '.ledger_current_index')"
OPEN_LEDGER_FEE="$(printf '%s\n' "${FEE_RESULT}" | jq -er '.drops.open_ledger_fee')"
ACCOUNT_BALANCE="$(printf '%s\n' "${ACCOUNT_INFO_RESULT}" | jq -er \
    '.account_data.Balance | tonumber / 1000000')"
XRP_CURRENCY_QUALITY="$(
    printf '%s\n' "${OFFER_RESULT}" |
        jq -er '
            if ((.offers // []) | length) == 0 then
                error("no offers found")
            else
                (.offers[0].quality | tonumber * 1000000)
            end
        '
)"

# Best-offer estimate. quality is expressed in serialized units:
# IOU per XRP drop, so multiply by 1,000,000 to get currency per XRP.
ACCOUNT_CALC_PRICE="$(
    awk -v balance="${ACCOUNT_BALANCE}" \
        -v quality="${XRP_CURRENCY_QUALITY}" \
        'BEGIN {printf "%.3f", balance * quality}'
)"

cat <<'EOF'
__  ______  ____    _             _
\ \/ /  _ \|  _ \  | |    ___  __| | __ _  ___ _ ___
 \  /| |_) | |_) | | |   / _ \/ _` |/ _` |/ _ \ '__|
 /  \|  _ <|  __/  | |__|  __/ (_| | (_| |  __/ |
/_/\_\_| \_\_|     |_____\___|\__,_|\__, |\___|_|
                                    |___/
EOF
printf 'UTC: %s\n' "$(LC_ALL=C date -u +%Y%m%dT%H%M%SZ)"
printf 'Rippled Server: %s\n' "${XRPL_SERVER}"
printf 'LedgerIndex: %s\n' "${LEDGER_INDEX}"
printf 'OpenLedgerFee: %s (drops)\n' "${OPEN_LEDGER_FEE}"
printf '%s\n' '------------------------------------------------------'
printf 'Issuer: %s\n' "${ISSUER}"
printf 'Currency: %s\n' "${CURRENCY}"
printf 'CurrencyCode: %s\n' "${CURRENCY_CODE}"
printf 'OfferLimit: %s\n' "${OFFER_LIMIT}"
printf 'Best offer price: 1 XRP = %s %s\n' \
    "${XRP_CURRENCY_QUALITY}" "${CURRENCY}"
printf '%s\n' '------------------------------------------------------'
printf 'Account: %s\n' "${ACCOUNT}"
printf 'Balance: %s XRP\n' "${ACCOUNT_BALANCE}"
printf 'Estimated value at best offer: %s %s\n' \
    "${ACCOUNT_CALC_PRICE}" "${CURRENCY}"
printf '%s\n' '------------------------------------------------------'
