#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: playlist [--dry-run] [--download]

Options:
  --dry-run      Show work without writing files or downloading audio
  --download     Download playlist audio as MP3 files

Environment:
  PLAYLIST_ID    YouTube playlist ID
  PLAYLIST_FILE  Output JSON path
  PLAYLIST_DIR   Audio output directory
EOF
}

dry_run=0
download=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run)
      dry_run=1
      ;;
    --download)
      download=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

readonly PLAYLIST_ID="${PLAYLIST_ID:-PLMXoRsxtzGfCH7cvhAnzN_T3KvKmdkB3s}"
readonly PLAYLIST_URL="https://youtube.com/playlist?list=${PLAYLIST_ID}"

if ! command -v yt-dlp >/dev/null 2>&1; then
  printf '%s\n' "yt-dlp not found; run: mise install" >&2
  exit 1
fi

if [ "${download}" -eq 1 ]; then
  if ! command -v ffmpeg >/dev/null 2>&1; then
    printf '%s\n' "ffmpeg not found; run: mise install" >&2
    exit 1
  fi

  readonly PLAYLIST_DIR="${PLAYLIST_DIR:-${XDG_MUSIC_DIR:-${HOME}/Music}/riddim}"
  printf 'Downloading playlist: %s\n' "${PLAYLIST_ID}"
  if [ "${dry_run}" -eq 1 ]; then
    printf 'Dry-run: audio would be written to %s\n' "${PLAYLIST_DIR}"
    exit 0
  fi

  mkdir -p "${PLAYLIST_DIR}"
  yt-dlp \
    --audio-format mp3 \
    --format bestaudio \
    --audio-quality 0 \
    --extract-audio \
    --output "${PLAYLIST_DIR}/%(title)s.%(ext)s" \
    --ignore-errors \
    --no-warnings \
    "${PLAYLIST_URL}"
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  printf '%s\n' "jq not found" >&2
  exit 1
fi

readonly PLAYLIST_FILE="${PLAYLIST_FILE:-${XDG_MUSIC_DIR:-${HOME}/Music}/playlist.json}"
printf 'Scanning playlist: %s\n' "${PLAYLIST_ID}"

if [ "${dry_run}" -eq 1 ]; then
  tmp_file="$(mktemp "${TMPDIR:-/tmp}/playlist.XXXXXX")"
else
  mkdir -p "$(dirname "${PLAYLIST_FILE}")"
  tmp_file="$(mktemp "${PLAYLIST_FILE}.tmp.XXXXXX")"
fi

cleanup() {
  rm -f "${tmp_file}"
}
trap cleanup EXIT

yt-dlp -j --flat-playlist "${PLAYLIST_URL}" |
  jq -s '
    map(
      select((.id // "") != "" and (.title // "") != "")
      | {title, videoId: .id}
    )
  ' > "${tmp_file}"

entry_count="$(jq 'length' "${tmp_file}")"

if [ "${dry_run}" -eq 1 ]; then
  printf 'Dry-run: %s entries would be written to %s\n' \
    "${entry_count}" "${PLAYLIST_FILE}"
  exit 0
fi

mv "${tmp_file}" "${PLAYLIST_FILE}"
trap - EXIT

printf 'Created %s (%s entries)\n' "${PLAYLIST_FILE}" "${entry_count}"
