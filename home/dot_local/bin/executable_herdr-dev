#!/usr/bin/env bash
# herdr-dev — herdr 起動エントリポイント: server 確保 → dev プリセット保証(タブ単位) → attach
# 使い方: autostart(zlogin / bash_profile)から呼ぶ。herdr 内の shell からの手動実行でも可
#         (その場合は構築のみで attach しない)。
# 仕様: プリセット構成要素(tab 102 / Dev / Docs / lazydocker)はタブ単位で冪等に保証される —
#       閉じられたタブは次回起動時に個別に復活する(プリセット常駐)。workspace も同様。
# 作り直し: herdr workspace close <workspace_id> && herdr-dev
# server が稼働中の通常起動 = タブ単位の存在保証のみ(既存 pane には触れない)。
# 自前で server を起動した場合 = snapshot 復元直後(pane は素 shell のみ)なので
# dev を閉じてコマンド再実行込みで完全再構築する。
# 応答 ID は herdr 0.9.5 の実機で確認済み: .result.{workspace.workspace_id, tab.tab_id,
# root_pane.pane_id, pane.pane_id}
# 環境変数: HERDR_DEV_CWD(dev workspace の cwd。既定 ~/dotfiles)、
#           HERDR_DEV_DATA(tab 102 の下段で cat.txt を表示する dir。既定 ~/。cat.txt が無ければ下段は作らない)
set -eu

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage: herdr-dev [-h|--help]

herdr の server を確保し、dev workspace のタブ(102 / Dev / Docs / lazydocker)を
足りない分だけ作ってから attach する。herdr 内から実行したときは attach しない。

Environment:
  HERDR_DEV_CWD   dev workspace の cwd(既定 ~/dotfiles。無ければ ~)
  HERDR_DEV_DATA  tab 102 の下段で cat.txt を表示する dir(既定 ~)
EOF
    exit 0
    ;;
esac

command -v herdr >/dev/null 2>&1 || exit 1

DEV_CWD="${HERDR_DEV_CWD:-$HOME/dotfiles}"
[ -d "$DEV_CWD" ] || DEV_CWD="$HOME"
DATA_DIR="${HERDR_DEV_DATA:-$HOME}"

server_running() {
  herdr status 2>/dev/null | grep -q 'status: running'
}

# label が dev の workspace の id(無ければ空)
dev_ws_id() {
  herdr workspace list 2>/dev/null |
    jq -r '.result.workspaces[]? | select(.label == "dev") | .workspace_id' |
    head -1
}

# 1) server 未稼働なら headless で起動して ready を待つ(失敗しても herdr 本体が起動する)
FRESH=0
SERVER_PID=""
if ! server_running; then
  nohup herdr server >/dev/null 2>&1 &
  SERVER_PID=$!
  i=0
  until server_running || [ "$i" -ge 30 ]; do
    i=$((i + 1))
    sleep 0.5
  done
  # 正の確認: 稼働中 server が「自分が起動したプロセス」であることのみ FRESH=1 とする
  # (status 探測の一時的失敗で既存 server が生きている場合は FRESH=0 → 破壊操作なし)
  if server_running && kill -0 "$SERVER_PID" 2>/dev/null; then
    FRESH=1
  fi
fi
# FRESH 時は boot 直後の API が不安定(restore 反映待ち)なので、実際に問い合わせが通るまで待つ
if [ "$FRESH" = 1 ]; then
  i=0
  until herdr workspace list >/dev/null 2>&1 || [ "$i" -ge 20 ]; do
    i=$((i + 1))
    sleep 0.5
  done
  sleep 1
fi

# 2) dev プリセット保証(タブ単位で冪等)
# ensure_dev_layout は `||` の左で呼ばれ set -e が効かない。作成系は結果を検査して return 1 する。
if ! command -v jq >/dev/null 2>&1; then
  echo "jq が無いため dev プリセットを保証しません" >&2
elif server_running; then
  # tab を作り、root pane の id を返す。失敗時は非 0
  new_tab() {
    local out cwd="$2"
    [ -d "$cwd" ] || cwd="$HOME"
    out=$(herdr tab create --workspace "$W" --label "$1" --cwd "$cwd") || return 1
    printf '%s' "$out" | jq -er '.result.root_pane.pane_id'
  }

  # pane を分割し、新しい pane の id を返す。失敗時は非 0
  split_pane() {
    local out
    out=$(herdr pane split --pane "$1" --direction "$2" ${3:+--cwd "$3"}) || return 1
    printf '%s' "$out" | jq -er '.result.pane.pane_id'
  }

  ensure_dev_layout() {
    if [ "${FRESH:-}" = 1 ]; then
      # server 再起動直後: 復元 pane は素 shell のみ(コマンドは死んでいる)。
      # close を試みた後のリスト再取得が冪等性の正本(list 直後は restore 反映が不安定なため 1s 待つ)
      sleep 1
      W=$(dev_ws_id)
      if [ -n "$W" ]; then
        herdr workspace close "$W" >/dev/null 2>&1 || true
      fi
    fi
    W=$(dev_ws_id)
    if [ -z "$W" ]; then
      # workspace create は最初の tab と root pane を同時に作る — それを tab「101」として流用
      R=$(herdr workspace create --label dev --cwd "$DEV_CWD") || return 1
      W=$(printf '%s' "$R" | jq -er '.result.workspace.workspace_id') || return 1
      T=$(printf '%s' "$R" | jq -er '.result.tab.tab_id') || return 1
      P=$(printf '%s' "$R" | jq -er '.result.root_pane.pane_id') || return 1
      herdr tab rename "$T" 101
      herdr pane run "$P" btm
    fi

    TABS=$(herdr tab list 2>/dev/null || true)
    if [ -z "$TABS" ]; then
      sleep 1
      TABS=$(herdr tab list 2>/dev/null || true)
    fi
    [ -n "$TABS" ] || return 1
    has_tab() {
      printf '%s' "$TABS" | jq -re --arg w "$W" --arg l "$1" \
        '.result.tabs[] | select(.workspace_id == $w and .label == $l) | .tab_id' >/dev/null 2>&1
    }

    if ! has_tab 102; then
      P=$(new_tab 102 "$HOME/Music") || return 1
      herdr pane run "$P" fastfetch
      if [ -f "$DATA_DIR/cat.txt" ]; then
        P=$(split_pane "$P" down "$DATA_DIR") || return 1
        herdr pane run "$P" "cat -- $(printf '%q' "$DATA_DIR/cat.txt")"
      fi
    fi

    if ! has_tab Dev; then
      P=$(new_tab Dev "$HOME/Developer") || return 1
      PB=$(split_pane "$P" down) || return 1 # 下段(全幅)
      herdr pane split --pane "$P" --direction right >/dev/null # 上段右(素 shell)
      herdr pane split --pane "$PB" --direction right >/dev/null # 下段右(素 shell)
    fi

    if ! has_tab Docs; then
      P=$(new_tab Docs "$HOME/Developer/docs") || return 1
      herdr agent start pi --kind pi --pane "$P" -- -c
    fi

    # tab「lazydocker」: docker 稼働 + lazydocker 導入時のみ(条件付き)
    if ! has_tab lazydocker && command -v docker >/dev/null 2>&1 && command -v lazydocker >/dev/null 2>&1 \
       && docker info >/dev/null 2>&1; then
      P=$(new_tab lazydocker "$HOME/Developer") || return 1
      herdr pane run "$P" lazydocker
      echo "tab「lazydocker」を作成しました(docker 稼働中)"
    fi

    echo "dev プリセットを保証しました($W)"
  }
  ensure_dev_layout || echo "プリセット保証に失敗 — 既存セッションに attach します" >&2
fi

# 3) attach(herdr 内からの手動実行時は構築のみ)
if [ -z "${HERDR_ENV:-}" ]; then
  herdr
fi
