#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: applist [-h|--help]

/Applications/app 配下のカテゴリ dir にある Chrome アプリ(.app)から
CrAppModeShortcutURL を集め、Markdown のリンク一覧を作る。macOS 専用。

Environment:
  APPLIST_ROOT  走査する dir(既定 /Applications/app)
  APPLIST_DIR   出力先 dir(既定 ~/Developer/applist)
  APPLIST_NAME  出力ファイル名(既定 applist.md)。既存ファイルは .bak に残す
EOF
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    "")
        ;;
    *)
        printf 'Unknown argument: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac

if [ "$(uname -s)" != "Darwin" ]; then
    printf '%s\n' "macOS only" >&2
    exit 1
fi

if ! command -v plutil >/dev/null 2>&1; then
    printf '%s\n' "plutil not found" >&2
    exit 1
fi

readonly RD="${APPLIST_ROOT:-/Applications/app}"
readonly APPLIST="${APPLIST_NAME:-applist.md}"
readonly APPLIST_DIR="${APPLIST_DIR:-${HOME}/Developer/applist}"
readonly APPLIST_FILE="${APPLIST_DIR}/${APPLIST}"

if [ ! -d "${RD}" ]; then
    printf 'Directory not found: %s\n' "${RD}" >&2
    exit 1
fi

mkdir -p "${APPLIST_DIR}"

tmp_file="$(mktemp "${APPLIST_FILE}.tmp.XXXXXX")"
cleanup() {
    rm -f "${tmp_file}"
}
trap cleanup EXIT

printf '# Applist\n' > "${tmp_file}"

for dir in "${RD}"/*/; do
    [ -d "${dir}" ] || continue

    app_found=0
    while IFS= read -r app_path; do
        plist_path="${app_path}/Contents/Info.plist"
        [ -f "${plist_path}" ] || continue

        if ! app_url="$(
            plutil -extract CrAppModeShortcutURL raw -o - "${plist_path}" 2>/dev/null
        )"; then
            continue
        fi
        [ -n "${app_url}" ] || continue

        if [ "${app_found}" -eq 0 ]; then
            category_name="${dir%/}"
            category_name="${category_name##*/}"
            printf '\n## %s\n' "${category_name}" >> "${tmp_file}"
            app_found=1
        fi

        # URL 中の括弧は Markdown のリンクを壊すので符号化する。
        app_url="${app_url//(/%28}"
        app_url="${app_url//)/%29}"

        app_name="${app_path##*/}"
        app_name="${app_name%.app}"
        printf '[%s](%s)\n' "${app_name}" "${app_url}" >> "${tmp_file}"
    done < <(
        find "${dir}" -maxdepth 1 -type d -name '*.app' -print |
            LC_ALL=C sort
    )

    if [ "${app_found}" -eq 1 ]; then
        printf '%s Done!\n' "${category_name}"
    fi
done

if [ -e "${APPLIST_FILE}" ]; then
    cp "${APPLIST_FILE}" "${APPLIST_FILE}.bak"
    printf 'Copied %s.bak\n' "${APPLIST}"
fi

mv "${tmp_file}" "${APPLIST_FILE}"
trap - EXIT

printf 'Created %s\n' "${APPLIST_FILE}"
