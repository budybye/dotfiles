#!/usr/bin/env bash

set -euo pipefail

# jjj 
# $1 "メッセージ" 
# $2 "ブックマーク名" 
# $3 "リモート名"
# --help
# --dry-run

# 変更を確定し、ブックマークを作成・更新してプッシュする

if ! command -v jj >/dev/null 2>&1; then
  printf '%s\n' "jj not found" >&2
  exit 1
fi

if [ -n "${1:-}" ]; then
  msg="$1"
else
  emojis=(
    '🎉' '✨' '🔧' '💄' '✏️' '📝' '🔥' '🐛' '♻️' '🚨' '🚧'
    '🍍' '🍕' '🐈' '♨️' '🍄' '🥦' '🌈' '🚲' '🏄' '🙏' '🌞'
    '🌕' '🏴‍☠️' '🥷' '🐳' '😈' '⛰️' '🌊' '🔫' '🚬' '☕️' '🍺'
  )
  emoji_index=$((RANDOM % ${#emojis[@]}))
  msg="${emojis[emoji_index]}"
fi

bookmark="${2:-}"
remote="${3:-origin}"

if ! jj root >/dev/null 2>&1; then
  printf '%s\n' "not a jj repository; initialize it first with: jj git init --colocate" >&2
  exit 1
fi

# gitとの不整合を解消（stale index対策）
jj git import >/dev/null

# ブックマーク名を自動検出（指定されていない場合）
# `_reserve/*` は change-id 予約用のローカル印なので進めない。
is_reserved_bookmark() {
  case "$1" in
    _reserve|_reserve/*) return 0 ;;
    *) return 1 ;;
  esac
}

if [ -z "${bookmark}" ] && command -v git >/dev/null 2>&1; then
  cand="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
  if [ -n "${cand}" ] && ! is_reserved_bookmark "${cand}"; then
    bookmark="${cand}"
  fi
fi

if [ -z "${bookmark}" ]; then
  # working copyの祖先上にあるtrunk系を優先
  for cand in main master trunk; do
    commit_id="$(
      jj log -r "bookmarks(exact:${cand}) & ancestors(@)" \
        -n 1 --no-graph -T 'commit_id'
    )"
    if [ -n "${commit_id}" ]; then
      bookmark="${cand}"
      break
    fi
  done
fi

if [ -z "${bookmark}" ]; then
  # working copy祖先上の最も近い非_reserved bookmark
  bookmark_candidates="$(
    jj log -r 'bookmarks() & ancestors(@)' --no-graph \
      -T 'bookmarks.map(|b| b.name()).join("\n") ++ "\n"'
  )"
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    is_reserved_bookmark "${name}" && continue
    bookmark="${name}"
    break
  done <<< "${bookmark_candidates}"
fi

if [ -z "${bookmark}" ]; then
  printf '%s\n' "bookmark could not be detected; specify it explicitly" >&2
  exit 1
fi

if is_reserved_bookmark "${bookmark}"; then
  printf 'refusing to advance reserved bookmark: %s\n' "${bookmark}" >&2
  exit 1
fi

# 未作成なら作るだけ（既存bookmarkを@へ動かさない）
bookmark_list="$(jj bookmark list --template 'name ++ "\n"')"
if ! printf '%s\n' "${bookmark_list}" | grep -Fx -- "${bookmark}" >/dev/null; then
  jj bookmark create "${bookmark}" -r @
fi

# 変更にメッセージを付けて確定し、ブックマークをコミットに移して指定先へプッシュ
jj describe -m "${msg}"
jj new
jj bookmark set "${bookmark}" -r @-
jj git push --remote "${remote}" --bookmark "${bookmark}"
