#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: jjj [-h|--help] ["メッセージ" ["ブックマーク名" ["リモート名"]]]

Arguments:
  メッセージ      コミットメッセージ(省略時はランダムな絵文字)
  ブックマーク名  進めるブックマーク(省略時は自動検出)
  リモート名      push 先(省略時は origin)

作業コピー(@)に変更があれば確定する。@ が空なら、確定済みの @- を対象にする。
対象のコミットへブックマークを作成・移動して push する。
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  -*)
    printf 'unknown option: %s (see --help)\n' "$1" >&2
    exit 2
    ;;
esac

if ! command -v jj >/dev/null 2>&1; then
  printf '%s\n' "jj not found" >&2
  exit 1
fi

bookmark="${2:-}"
remote="${3:-origin}"

# .jj がなければ、既存の .git を colocate で取り込む（.git がなければ新規作成せず終了）
if ! jj root >/dev/null 2>&1; then
  if ! git_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    printf '%s\n' "not a jj or git repository; refusing to create one" >&2
    exit 1
  fi
  jj git init --colocate "${git_root}"
fi

# gitとの不整合を解消（stale index対策）
jj git import >/dev/null

# 空の作業コピーに describe/new すると空コミットが積まれるので、その場合は確定済みの @- を push する。
# @- が root なら push するものが無い。
commit_changes=1
if [ "$(jj log -r @ --no-graph -T 'empty')" = "true" ]; then
  commit_changes=0
  if [ "$(jj log -r @- --no-graph -T 'root')" = "true" ]; then
    printf '%s\n' "no changes to commit" >&2
    exit 0
  fi
  if [ -n "${1:-}" ]; then
    printf '%s\n' "working copy is empty; message ignored, pushing @-" >&2
  fi
fi

# ブックマーク名を自動検出（指定されていない場合）
# `_reserve/*` は change-id 予約用のローカル印なので進めない。
is_reserved_bookmark() {
  case "$1" in
    _reserve|_reserve/*) return 0 ;;
    *) return 1 ;;
  esac
}

# colocate では git の HEAD が常に detached なので、git のブランチ名は当てにしない。
if [ -z "${bookmark}" ]; then
  # working copyの祖先上にあるtrunk系を優先
  for cand in main master trunk; do
    commit_id="$(
      jj log -r "bookmarks(exact:${cand}) & ancestors(@)" \
        -n 1 --no-graph -T 'commit_id'
    )"
    if [ -n "${commit_id}" ]; then
      bookmark="${cand}"
      break
    fi
  done
fi

if [ -z "${bookmark}" ]; then
  # working copy祖先上の最も近い非_reserved bookmark
  bookmark_candidates="$(
    jj log -r 'bookmarks() & ancestors(@)' --no-graph \
      -T 'bookmarks.map(|b| b.name()).join("\n") ++ "\n"'
  )"
  while IFS= read -r name; do
    [ -n "${name}" ] || continue
    is_reserved_bookmark "${name}" && continue
    bookmark="${name}"
    break
  done <<< "${bookmark_candidates}"
fi

if [ -z "${bookmark}" ]; then
  printf '%s\n' "bookmark could not be detected; specify it explicitly" >&2
  exit 1
fi

if is_reserved_bookmark "${bookmark}"; then
  printf 'refusing to advance reserved bookmark: %s\n' "${bookmark}" >&2
  exit 1
fi

# colocate init 直後は git の main が local に入るが main@origin は untracked のまま。
# このままだと push が "Non-tracking remote bookmark exists" で失敗するため track する。
# remote 側に無ければ何もしない。
jj bookmark track "${bookmark}@${remote}" >/dev/null 2>&1 || true

if [ "${commit_changes}" -eq 1 ]; then
  if [ -n "${1:-}" ]; then
    msg="$1"
  else
    emojis=(
      '🎉' '✨' '🔧' '💄' '✏️' '📝' '🔥' '🐛' '♻️' '🚨' '🚧'
      '🍍' '🍕' '🐈' '♨️' '🍄' '🥦' '🌈' '🚲' '🏄' '🙏' '🌞'
      '🌕' '🏴‍☠️' '🥷' '🐳' '😈' '⛰️' '🌊' '🔫' '🚬' '☕️' '🍺'
    )
    emoji_index=$((RANDOM % ${#emojis[@]}))
    msg="${emojis[emoji_index]}"
  fi
  jj describe -m "${msg}"
  jj new
fi

# `bookmark set` は無ければ作る。@- が確定済みのコミット。
jj bookmark set "${bookmark}" -r @-
jj git push --remote "${remote}" --bookmark "${bookmark}"
