#!/usr/bin/env bash
set -eu

echo "run_once_before_bw.sh.tmpl"
cd "${HOME}"
echo "--------------------------------"

# マスターパスワードを暗号化 パスフレーズが要求される
# echo "${MASTER}" | chezmoi encrypt > {{ .chezmoi.sourceDir }}/shhh.txt

{{/* マスターパスワードを復号 パスフレーズが要求される */}}
{{ if ne .bitwarden false }}

echo "decrypt shhh.txt"
MASTER="$(chezmoi decrypt {{ .chezmoi.sourceDir }}/shhh.txt)"
echo "--------------------------------"

{{ end }}

SESSION="$(pwd)/.env"

# mise なければインストール
mise_install() {
    if command -v mise >/dev/null 2>&1; then
        echo "mise already installed."

    elif command -v curl >/dev/null 2>&1; then
        curl https://mise.run | sh || echo "mise install failed."
        export PATH="${HOME}/.local/bin:${PATH}"

    else
        echo "mise install failed."
        exit 1
    fi

    mkdir -p "${HOME}/.config/mise"
    export MISE_CONFIG_DIR="${HOME}/.config/mise"
    eval "$(mise activate bash)"
    
    mise --version || echo "mise command not found."
    echo "mise installed"
    echo "--------------------------------"
}

# npm で bitwarden cli をインストール
bw_install() {
    if command -v bw >/dev/null 2>&1; then
        echo "bw already installed."

    elif command -v mise >/dev/null 2>&1; then
        mise use -g bitwarden || echo "bitwarden cli install failed."

    else
        echo "npm not found."

    fi

    bw --version || echo "bw command not found."
    echo "Bitwarden CLI installed."
    echo "--------------------------------"
}

bw_unlock() {
    local bw_cmd=""
    if command -v bw >/dev/null 2>&1; then
        bw_cmd="bw"
    else
        echo "bw cli not found."
        return 1
    fi

    # 既に有効なセッションがあればスキップ
    if [ -f "${SESSION}" ]; then
        set -a
        # shellcheck source=/dev/null
        . "${SESSION}" 2>/dev/null || echo "session file could not be loaded."
        set +a
        if [ -n "${BW_SESSION:-}" ] && ${bw_cmd} status 2>/dev/null | grep -q '"status":"unlocked"'; then
            echo "BW_SESSION already valid, skipping unlock."
            cat "${SESSION}"
            echo "--------------------------------"
            return 0
        fi
    fi

    # ロック解除
    ${bw_cmd} login {{ .email }} ${MASTER} || echo "bw login failed."
    printf 'export BW_SESSION="%s"\n' "$(${bw_cmd} unlock ${MASTER} --raw 2>/dev/null)" >> "${SESSION}" || echo "bw unlock failed."

    if [ -f "${SESSION}" ]; then
        cat "${SESSION}"
    else
        echo "export BW_SESSION=${BW_SESSION:-}" > "${SESSION}" && cat "${SESSION}"
    fi
    echo "--------------------------------"
}

echo "bitwarden setup"
mise_install
bw_install

{{ if ne .bitwarden false }}
bw_unlock
{{ end }}

echo "bitwarden setup complete"
echo "--------------------------------"
