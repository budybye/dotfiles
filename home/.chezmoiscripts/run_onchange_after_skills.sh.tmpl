#!/usr/bin/env bash
set -eu

# agents.yaml の agents.skills が変更された時に再実行される
# ハッシュ: {{ .agents.skills | toJson | sha256sum }}

if command -v skills >/dev/null 2>&1; then
    skills_command=(skills)
elif command -v npx >/dev/null 2>&1; then
    skills_command=(npx skills)
else
    printf '%s\n' 'skills CLI is not installed and npx is unavailable.' >&2
    exit 1
fi

echo "skills"
echo "--------------------------------"

{{- range $repo, $skills := .agents.skills }}
{{- range $skill := $skills }}
"${skills_command[@]}" add {{ shellQuote $repo }} -s {{ shellQuote $skill }} -a zed -y -g
{{- end }}
{{- end }}

echo "--------------------------------"
echo "skills install completed."
