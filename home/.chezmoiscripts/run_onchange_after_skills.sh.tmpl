#!/usr/bin/env bash
set -eu

# packages.yaml の packages.claude.skills が変更された時に再実行される
# ハッシュ: {{ .packages.agents.skills | toJson | sha256sum }}

echo "skills.sh"
echo "--------------------------------"

{{ range .packages.agents.skills -}}
npx skills add {{ . }} -g -y || echo "skill install failed: {{ . }}"
{{ end -}}

echo "--------------------------------"
echo "skills install completed."
echo "--------------------------------"
