{
  // "schema": "https://github.com/devcontainers/spec/blob/main/schemas/devContainer.schema.json",
  "name": "ubuntu",
  "build": {
    "context": ".",
    "dockerfile": "slim.Dockerfile",
    "options": [
      "--secret=id=github_token,env=GITHUB_TOKEN"
    ],
    "args": {
      "DEV_UID": "1024",
      "DEV_GID": "1024",
      "DOTFILES_REF": "${localEnv:DOTFILES_REF:main}",
      "DOTFILES_REV": "${localEnv:DOTFILES_REV:unknown}",
    }
  },
  // "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "containerUser": "root",
  "remoteUser": "dev",
  "workspaceFolder": "/workspaces/chezmoi",
  "overrideCommand": false,
  "forwardPorts": [22],
  // "privileged": true,
  // "initializeCommand": "echo 'Dev container initializing...'",
  // "onCreateCommand": "echo 'Dev container creating...'",
  // "postCreateCommand": "echo 'Dev container post created...'",
  // "postStartCommand": "echo 'Dev container post started...'",
  // "postAttachCommand": "echo 'Dev container post attached...'",
  "shutdownAction": "stopCompose",
  "remoteEnv": {
    "REMOTE_CONTAINERS": "true",
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.tabSize": 4,
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 3000,
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
        },
        "dotfiles.installCommand": "~/dotfiles/install.sh",
        "dotfiles.repository": "budybye/dotfiles",
        "dotfiles.targetPath": "~/dotfiles",
      },
      "extensions": [
        // "42crunch.vscode-openapi",
        "adpyke.codesnap",
        "ambar.bundle-size",
        // "antfu.slidev",
        // "anthropic.claude-code",
        "bradlc.vscode-tailwindcss",
        // "bmewburn.vscode-intelephense-client",
        // "bierner.markdown-emoji",
        "coderabbit.coderabbit-vscode",
        "christian-kohler.npm-intellisense",
        "christian-kohler.path-intellisense",
        // "corschenzi.mermaid-graphical-editor",
        // "dbaeumer.vscode-eslint",
        // "davidanson.vscode-markdownlint",
        // "echoapi.echoapi-for-vscode",
        // "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "editorconfig.editorconfig",
        "formulahendry.auto-close-tag",
        "formulahendry.auto-complete-tag",
        "formulahendry.auto-rename-tag",
        "foxundermoon.shell-format",
        "dbaeumer.vscode-eslint",
        "docker.docker",
        "golang.go",
        "github.vscode-github-actions",
        // "hediet.vscode-drawio",
        // "hono.hono",
        "hverlin.mise-vscode",
        // "ibm.output-colorizer",
        // "intellsmi.comment-translate",
        // "ivanarjona.cloudflaretunnel",
        "jinliming2.vscode-go-template",
        // "keploy.keployio",
        // "kdl-org.kdl",
        // "kimlimjustin.jsdoc-generator",
        // "lokalise.i18n-ally",
        "metaphore.kanagawa-vscode-color-theme",
        // "matthewpi.caddyfile-support",
        // "marp-team.marp-vscode",
        // "mermaidchart.vscode-mermaid-chart",
        "mechatroner.rainbow-csv",
        // "mikestead.dotenv",
        "monokai.theme-monokai-pro-vscode",
        // "ms-mssql.mssql",
        // "mtxr.sqltools",
        "ms-ceintl.vscode-language-pack-ja",
        "ms-python.python",
        "ms-vscode.hexeditor",
        "ms-vscode.makefile-tools",
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode-remote.remote-ssh",
        // "ms-vscode-remote.remote-wsl",
        "ms-vscode-remote.vscode-remote-extensionpack",
        "naumovs.color-highlight",
        "oderwat.indent-rainbow",
        "oven.bun-vscode",
        // "qwtel.sqlite-viewer",
        "rphlmr.vscode-drizzle-orm",
