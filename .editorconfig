# EditorConfigはUTF-8を使用することを推奨します
root = true

# 全てのファイルに適用(デフォルト設定)
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# インデント ４
[*.{py,pyi,php,java,rs,go}]
indent_size = 4

# Makefile
[Makefile]
indent_style = tab
indent_size = 4

# Markdown
[*.{md,mdx,mdc}]
indent_style = tab
tab_width = 4

# .env
[{.env,.env.*}]
indent_style = tab
indent_size = 4

# wasm
[*.{wat,wast,wasm}]
indent_style = tab
indent_size = 2

# ignore
[*ignore]
indent_style = tab
indent_size = 2
